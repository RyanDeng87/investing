awing/2010/main"><a:solidFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:srgbClr val="FFFFFF" /></a:solidFill></a14:hiddenFill></a:ext></a:extLst></xdr:spPr></xdr:pic><xdr:clientData /></xdr:twoCellAnchor><xdr:twoCellAnchor><xdr:from><xdr:col>1</xdr:col><xdr:colOff>38100</xdr:colOff><xdr:row>83</xdr:row><xdr:rowOff>180974</xdr:rowOff></xdr:from><xdr:to><xdr:col>19</xdr:col><xdr:colOff>104775</xdr:colOff><xdr:row>94</xdr:row><xdr:rowOff>38099</xdr:rowOff></xdr:to><xdr:sp><xdr:nvSpPr><xdr:cNvPr id="8" name="TextBox 7" /><xdr:cNvSpPr txBox="1" /></xdr:nvSpPr><xdr:spPr><a:xfrm><a:off x="342900" y="15992474" /><a:ext cx="11039475" cy="1952625" /></a:xfrm><a:prstGeom prst="rect"><a:avLst /></a:prstGeom><a:solidFill><a:schemeClr val="lt1" /></a:solidFill><a:ln w="9525" cmpd="sng"><a:solidFill><a:schemeClr val="lt1"><a:shade val="50000" /></a:schemeClr></a:solidFill></a:ln></xdr:spPr><xdr:style><a:lnRef idx="0"><a:scrgbClr r="0" g="0" b="0" /></a:lnRef><a:fillRef idx="0"><a:scrgbClr r="0" g="0" b="0" /></a:fillRef><a:effectRef idx="0"><a:scrgbClr r="0" g="0" b="0" /></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="dk1" /></a:fontRef></xdr:style><xdr:txBody><a:bodyPr vertOverflow="clip" horzOverflow="clip" wrap="square" rtlCol="0" anchor="t" /><a:lstStyle /><a:p><a:r><a:rPr lang="en-US" sz="1100" b="1" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>Sorting is a differentiator</a:t></a:r><a:r><a:rPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t> – We do a dependent sort (first sort by size and then by metric), whereas French does an independent sort.</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-US" sz="1100" b="1" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>Universe is a differentiator </a:t></a:r><a:r><a:rPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>– We use the same data sources as French (CRSP and XF), and we apply filters to get close to French’s universe, but no guarantee that the universes will be exactly the same.</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-US" sz="1100" b="1" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>Historical refreshes are a differentiator</a:t></a:r><a:r><a:rPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t> – French refreshes his entire history every month, whereas AQR has not historically done that. We’ve just appended the last month to the time series. However as of late July, we started refreshing the historical data monthly.</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-US" sz="1100" b="1" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>Cutoffs are not a differentiator</a:t></a:r><a:r><a:rPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t> – We both use 30th and 70th NYSE percentiles for high/low and the median NYSE breakpoint for small/big.</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:endParaRPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-US" sz="1100" b="1" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t>Risk-free rate is not a differentiator</a:t></a:r><a:r><a:rPr lang="en-US" sz="1100" b="0" i="0" u="none" strike="noStrike" baseline="0"><a:solidFill><a:schemeClr val="dk1" /></a:solidFill><a:effectLst /><a:latin typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /><a:ea typeface="+mn-ea" charset="0" /><a:cs typeface="Times New Roman" panose="02020603050405020304" pitchFamily="18" charset="0" /></a:rPr><a:t> – Both market and factor returns are in excess of the risk-free rate (t-bills).</a:t></a:r></a:p></xdr:txBody></xdr:sp><xdr:clientData /></xdr:twoCellAnchor></xdr:wsDr>